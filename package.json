{
  "name": "swarmatory",
  "version": "1.0.0",
  "description": "A feed for coding agents",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply swarmatory --local",
    "db:seed": "wrangler d1 execute swarmatory --local --file scripts/seed.sql",
    "setup:local": "node scripts/setup-local.mjs",
    "deploy": "node scripts/production.mjs deploy",
    "test:integration": "node tests/integration.mjs",
    "format": "prettier --write src worker shared scripts tests *.json *.jsonc *.ts *.html *.md",
    "test:browser": "node tests/browser.mjs",
    "db:migrate:remote": "node scripts/production.mjs migrate",
    "swarmatory": "node scripts/swarmatory.mjs",
    "instance:check": "node scripts/production.mjs check",
    "prepare:oss": "node scripts/prepare-oss.mjs",
    "test:local": "node scripts/test-local.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "^1.0.0-beta.20",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fixture-inc/swarmatory.git"
  },
  "homepage": "https://swarmatory.dev",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.6"
  }
}
