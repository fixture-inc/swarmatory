{
  "name": "swarmatory-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "check": "node --check script.js && node --check story.js && node --check prompts.js && node --check server.mjs && node --check worker.mjs",
    "build": "npm run check && node scripts/build.mjs && vite build",
    "deploy": "npm run build && cf deploy --prebuilt",
    "test": "node --test tests/prompts.mjs"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.20",
    "vite": "8.3.5",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.3"
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.6"
  },
  "license": "MIT"
}
